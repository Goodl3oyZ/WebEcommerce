{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --silent",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage",
    "dev": "nodemon --watch src --ext js,json --exec \"node index.js\"",
    "dev:debug": "nodemon --watch src --ext js,json --exec \"node --inspect=0.0.0.0:9229 index.js\"",
    "start": "node index.js",
    "migrate": "npx dotenv-cli -e .env -- drizzle-kit push",
    "migrate:sql": "npx dotenv-cli -e .env -- node scripts/run-migrate.mjs",
    "generate": "npx dotenv-cli -e .env -- drizzle-kit generate --name schema",
    "db:setup": "npm run migrate && npm run seed:all",
    "seed": "node src/seed/seed.js",
    "seed:address": "node src/seed/seed-address-thai.js",
    "seed:shipping": "node src/seed/seed-shipping-payment.js",
    "seed:all": "node src/seed/seed.js && node src/seed/seed-shipping-payment.js && node src/seed/seed-address-thai.js",
    "clearSeed": "node src/seed/clear.js",
    "db:reset": "npm run migrate && npm run clearSeed && npm run seed:all",
    "docs:validate": "node scripts/validate-swagger.js",
    "storage:init": "node scripts/init-buckets.mjs",
    "audit:routes": "node scripts/audit-routes.js",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "test:infra:down": "docker compose -f docker-compose.test.yml down",
    "test:baseline:prune": "node scripts/prune-route-baseline.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "compression": "^1.8.0",
    "connect-redis": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^8.0.7",
    "npm": "^11.3.0",
    "omise": "^1.0.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.15.6",
    "rate-limit-redis": "^4.2.0",
    "redis": "^5.1.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.3",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/src/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/src/tests/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setupAfterEnv.js"
    ],
    "globalSetup": "<rootDir>/src/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/src/tests/globalTeardown.js",
    "testTimeout": 30000,
    "maxWorkers": 4,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**",
      "!src/seed/**"
    ]
  }
}
