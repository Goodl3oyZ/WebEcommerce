# Copy to .env.production and fill in every value. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# Use hex/alphanumeric passwords: they are embedded in connection URLs.

# --- Public site -----------------------------------------------------------
DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com
# Shown on /privacy and /data-deletion (optional; the support chat is always listed)
CONTACT_EMAIL=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=webecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=webecommerce

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=

# --- Object storage (SeaweedFS S3) -------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth secrets (each at least 32 characters) ------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
JWT_ACCESS_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=2592000

# --- Payments (Omise live keys) ----------------------------------------------
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# --- Email (SMTP) ------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- OAuth (callback: https://$DOMAIN/oauth/<provider>/callback) -------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Security / uploads ------------------------------------------------------
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=300
PASSWORD_MIN_LENGTH=8
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# --- API docs (disabled in production unless enabled here) -------------------
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASS=

# --- Admin seeding -------------------------------------------------------------
# POST /api/admin/seed can DELETE all users/products. Keep false in production.
ALLOW_ADMIN_SEED=false

# Unpaid orders keep their stock for this many minutes, then the payment worker
# (runs every minute inside the API) confirms with Omise and expires them.
PAYMENT_DEADLINE_MINUTES=30

# Shipped orders the customer never confirms are marked delivered after this
# many days (then they can be reviewed).
AUTO_DELIVER_DAYS=7
