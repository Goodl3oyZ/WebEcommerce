# systemd unit for the deploy webhook. Install (see deploy/README.md):
#   cp deploy/webhook/webecommerce-deploy.service /etc/systemd/system/
#   systemctl enable --now webecommerce-deploy
[Unit]
Description=WebEcommerce deploy webhook
After=network-online.target docker.service
Wants=network-online.target

[Service]
# DEPLOY_SECRET (and optionally DEPLOY_BRANCH, APP_DIR, PORT) live here, mode 600.
EnvironmentFile=/etc/webecommerce-deploy.env
ExecStart=/usr/bin/env node /opt/webecommerce/deploy/webhook/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
